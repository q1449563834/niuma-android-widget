<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.feiyuaq.niuma">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 关掉秒级刷新后靠闹钟每分钟刷新小部件。Android 13+ 上 SCHEDULE_EXACT_ALARM 默认不给，
         改用在 13+ 自动授予的 USE_EXACT_ALARM（本应用不上架 Google Play，只做侧载分发）；
         低版本仍走 SCHEDULE_EXACT_ALARM。都拿不到时自动退化成「尽量准时」。 -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TickerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="home_widget_realtime_clock" />
        </service>

        <receiver
            android:name=".NiumaWidget1x4"
            android:exported="true"
            android:label="@string/widget_1x4_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_1x4" />
        </receiver>

        <receiver
            android:name=".NiumaWidget2x4"
            android:exported="true"
            android:label="@string/widget_2x4_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x4" />
        </receiver>

        <receiver
            android:name=".NiumaWidget1x2"
            android:exported="true"
            android:label="@string/widget_1x2_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_1x2" />
        </receiver>

        <receiver
            android:name=".NiumaWidget2x2"
            android:exported="true"
            android:label="@string/widget_2x2_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x2" />
        </receiver>

        <!-- 关掉秒级刷新后每分钟响一次的闹钟，收到就重画四块小部件并续下一次 -->
        <receiver
            android:name=".MinuteTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.feiyuaq.niuma.action.MINUTE_TICK" />
            </intent-filter>
        </receiver>

        <!-- 开机 / 覆盖安装后把秒级刷新服务拉回来 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
